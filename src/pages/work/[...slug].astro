---
import { getCollection, render } from 'astro:content'
import Case from '../../layouts/Case.astro'

export async function getStaticPaths() {
  // Drafts are never rendered — see the `draft` note in src/content.config.ts.
  const items = await getCollection('work', ({ data }) => !data.draft)
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }))
}

const { item } = Astro.props
const { Content } = await render(item)
---

<Case
  title={item.data.title}
  category={item.data.category}
  period={item.data.period}
  summary={item.data.summary}
  tags={item.data.tags}
  url={item.data.url}
>
  <Content />
</Case>
