---
import '../../styles/diagram.css'
import ArrowDefs from './ArrowDefs.astro'

interface Props {
  caption?: string
}

const {
  caption = 'A zero-to-one build: data collected from manual forklift operation trains a detector whose boxes are indexed into the aligned depth image, turning a 2D detection into the 6-DoF pose the planner actually needs.',
} = Astro.props
---

<figure>
  <svg
    class="diagram"
    viewBox="0 0 820 290"
    role="img"
    aria-label="Pipeline diagram: data self-collected from manual forklift operation is labelled and used to train a ResNet-backbone detector from scratch. At runtime an RGB frame produces a bounding box which is indexed into the aligned depth frame to estimate pallet pose, which feeds trajectory planning on the autonomous forklift."
  >
    <ArrowDefs />

    <!-- Training -->
    <rect class="d-group" x="16" y="30" width="330" height="150"></rect>
    <text class="d-group-label" x="26" y="48">Offline · training</text>

    <rect class="d-box" x="32" y="66" width="140" height="56"></rect>
    <text class="d-label" x="102" y="88" text-anchor="middle">Self-collected data</text>
    <text class="d-sub" x="102" y="103" text-anchor="middle">manual forklift runs</text>
    <text class="d-sub" x="102" y="116" text-anchor="middle">in-warehouse</text>

    <rect class="d-box" x="204" y="66" width="126" height="56"></rect>
    <text class="d-label" x="267" y="88" text-anchor="middle">Detector</text>
    <text class="d-sub" x="267" y="103" text-anchor="middle">ResNet backbone</text>
    <text class="d-sub" x="267" y="116" text-anchor="middle">trained from scratch</text>

    <text class="d-sub" x="181" y="150" text-anchor="middle">label · augment · train</text>

    <!-- Runtime -->
    <rect class="d-group" x="374" y="30" width="430" height="220"></rect>
    <text class="d-group-label" x="384" y="48">On-vehicle · runtime</text>

    <rect class="d-box" x="392" y="66" width="112" height="46"></rect>
    <text class="d-label" x="448" y="85" text-anchor="middle">RGB frame</text>
    <text class="d-sub" x="448" y="100" text-anchor="middle">forward camera</text>

    <rect class="d-box" x="392" y="150" width="112" height="46"></rect>
    <text class="d-label" x="448" y="169" text-anchor="middle">Depth frame</text>
    <text class="d-sub" x="448" y="184" text-anchor="middle">registered RGB-D</text>

    <rect class="d-box" x="540" y="66" width="112" height="46"></rect>
    <text class="d-label" x="596" y="85" text-anchor="middle">Bounding box</text>
    <text class="d-sub" x="596" y="100" text-anchor="middle">pallet + pockets</text>

    <rect class="d-box d-box-accent" x="540" y="150" width="112" height="46"></rect>
    <text class="d-label" x="596" y="169" text-anchor="middle">Pose estimate</text>
    <text class="d-sub" x="596" y="184" text-anchor="middle">position + yaw</text>

    <rect class="d-box" x="688" y="108" width="100" height="46"></rect>
    <text class="d-label" x="738" y="127" text-anchor="middle">Trajectory</text>
    <text class="d-sub" x="738" y="142" text-anchor="middle">approach + fork</text>

    <!-- Flows -->
    <g color="var(--border-strong)">
      <path class="d-flow" d="M172 94 L200 94"></path>
      <path class="d-flow" d="M330 94 L388 94"></path>
      <path class="d-flow" d="M504 89 L536 89"></path>
      <path class="d-flow" d="M596 112 L596 146"></path>
      <path class="d-flow" d="M504 173 L536 173"></path>
    </g>
    <g color="var(--accent)">
      <path class="d-flow d-flow-accent" d="M652 173 L670 173 L670 131 L684 131"></path>
    </g>

    <text class="d-sub" x="596" y="132" text-anchor="middle">index box → depth</text>
    <text class="d-sub" x="410" y="228">2D detection becomes a 6-DoF grasp target</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
