---
/**
 * Arrowhead marker shared by every diagram.
 * `markerUnits="userSpaceOnUse"` keeps the head a fixed size regardless of the
 * stroke width of the path that references it.
 */
---

<defs>
  <marker
    id="d-arrow"
    viewBox="0 0 8 8"
    refX="7"
    refY="4"
    markerWidth="8"
    markerHeight="8"
    markerUnits="userSpaceOnUse"
    orient="auto"
  >
    <path d="M0 1 L7 4 L0 7 z" fill="currentColor" opacity="0.65"></path>
  </marker>
</defs>
