---
interface Props {
  id: string
  title: string
}

const { id, title } = Astro.props
---

<section id={id} aria-labelledby={`${id}-heading`} data-reveal>
  <h2 class="eyebrow" id={`${id}-heading`}>{title}</h2>
  <div class="section-body">
    <slot />
  </div>
</section>

<style>
  section {
    margin-bottom: var(--space-2xl);
    scroll-margin-top: var(--space-lg);
  }

  .section-body {
    margin-top: var(--space-md);
  }
</style>
