---
import Base from './Base.astro'
import TagList from '../components/TagList.astro'

interface Props {
  title: string
  category: string
  period: string
  summary: string
  tags: string[]
  url?: string
}

const { title, category, period, summary, tags, url } = Astro.props
---

<Base title={title} description={summary}>
  <div class="wrap">
    <a class="back" href="/#work">← Selected work</a>

    <main id="main">
      <article>
        <header>
          <p class="mono">
            {category} · {period}
            {
              url && (
                <>
                  {' · '}
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {url.replace(/^https?:\/\//, '')}
                  </a>
                </>
              )
            }
          </p>
          <h1>{title}</h1>
          <p class="summary">{summary}</p>
          <TagList tags={tags} label="Technologies used" />
        </header>

        <div class="prose">
          <slot />
        </div>
      </article>

      <nav class="case-foot">
        <a href="/#work">← Selected work</a>
        <a href="/">Home</a>
      </nav>
    </main>
  </div>
</Base>

<style>
  .wrap {
    max-width: 52rem;
    margin-inline: auto;
    padding: var(--space-lg) var(--space-md) var(--space-2xl);
  }

  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-xl);
  }

  .back:hover {
    color: var(--accent);
    text-decoration: none;
  }

  header {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: var(--step-3);
    margin-top: var(--space-xs);
  }

  .summary {
    color: var(--muted);
    font-size: var(--step-1);
    margin-top: var(--space-md);
    max-width: var(--measure);
  }

  /* Case-study body. Not scoped-only: the MDX content is injected through
     <slot>, so these rules have to reach descendants Astro didn't compile here. */
  .prose {
    margin-top: var(--space-xl);
  }

  .prose :global(h2) {
    font-size: var(--step-2);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .prose :global(p) {
    color: var(--muted);
    margin-top: var(--space-md);
    max-width: var(--measure);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(ul) {
    margin-top: var(--space-md);
    display: grid;
    gap: var(--space-sm);
  }

  .prose :global(ul li) {
    position: relative;
    padding-left: 1.25rem;
    color: var(--muted);
    max-width: var(--measure);
  }

  .prose :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 6px;
    height: 1px;
    background: var(--accent);
  }

  .prose :global(figure) {
    margin: var(--space-xl) 0;
  }

  .case-foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
