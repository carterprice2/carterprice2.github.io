# Cloudflare Pages response headers.
# GitHub Pages cannot set these at all — it is the main reason this site moved.
# Syntax: a path pattern, then indented `Header: value` lines.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  # No `preload`. That directive is a standing commitment that is awkward to
  # unwind, and .dev is already HSTS-preloaded at the TLD, so it buys nothing.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # 'unsafe-inline' is required because Astro inlines its small module scripts
  # and scoped styles, and their hashes change every build — a static header
  # file cannot track them. The site has no forms, no user input and no
  # third-party scripts, so there is no injection path for it to widen; the
  # directive still blocks loading script from any external origin.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Legacy orphan page, kept verbatim at its original URL. It predates the
# rebuild and loads jQuery/Bootstrap from CDNs, so it needs its own policy
# rather than dragging those origins into the site-wide one above.
/BRtrackrecords.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://ajax.googleapis.com https://cdnjs.cloudflare.com https://maxcdn.bootstrapcdn.com; style-src 'self' 'unsafe-inline' https://maxcdn.bootstrapcdn.com; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'

# Astro fingerprints everything under /_astro/, so it is safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
